{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEWLAW",
  "version": "0.1.13",
  "identifier": "com.newlaw.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../app run dev -- --host --port 5173",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },
  "app": {
    "security": {
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "title": "NEWLAW",
        "width": 1280,
        "height": 768,
        "resizable": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Lucashungaro123/NEWLAW/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEMDg1Q0ZDNDQ5OTdGMjUKUldRbGY1bEUvRndJRGNqbGVGRlBvaGNiZFJkTFltV1RFRXRzMm1NY2Jib05zVmlTV3VNQ2c2WjUK"
    }
  }
}
