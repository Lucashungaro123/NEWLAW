{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEWLAW",
  "version": "0.1.0",
  "identifier": "com.newlaw.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../app run dev -- --host --port 5173",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },
  "app": {
    "windows": [
      {
        "title": "NEWLAW",
        "width": 1280,
        "height": 768,
        "resizable": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "active": true
    }
  }
}
